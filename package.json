{
  "name": "chrona-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bootstrap baseline for a live geospatial digital twin platform.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "cesium": "^1.140.0",
    "leaflet": "^1.9.4",
    "pg": "^8.16.3"
  },
  "scripts": {
    "api:dev": "tsx --env-file=.env apps/api/src/server.ts",
    "web:dev": "tsx apps/web/src/server.ts",
    "worker:fixture": "tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "gate": "npm run gate:docs && npm run gate:architecture && npm run gate:contracts && npm run gate:adapters",
    "gate:docs": "tsx scripts/check-required-docs.ts",
    "gate:architecture": "tsx scripts/check-architecture-boundaries.ts",
    "gate:contracts": "tsx scripts/check-contract-artifacts.ts",
    "gate:adapters": "tsx scripts/check-adapter-fixtures.ts",
    "test": "npm run test:vitest && npm run test:e2e",
    "test:vitest": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:replay": "vitest run tests/replay",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm run lint && npm run gate && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "testcontainers": "^11.13.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
