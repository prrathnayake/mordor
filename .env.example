# Database connection
DATABASE_URL=postgres://postgres:password@localhost:5432/chrona

# API server port (default: 3000)
API_PORT=3000

# Web server port (default: 3001)
WEB_PORT=3001

# Web basemap configuration for the Cesium globe. Use `arcgis-world-imagery` for
# sharper aerial imagery, `osm-street` for street-cartography tiles, or
# `url-template` for a custom XYZ tile service.
MAP_IMAGERY_PROVIDER=arcgis-world-imagery
MAP_IMAGERY_URL=
MAP_IMAGERY_CREDIT=
MAP_IMAGERY_MAX_LEVEL=19

# Optional close-range 3D street scene support for the inspector's ground-view action.
# `google-photorealistic` uses Google photorealistic 3D tiles, `osm-buildings` loads
# Cesium's OSM buildings tileset, and `none` keeps the current system unchanged.
STREET_SCENE_PROVIDER=none
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=

# Logging level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Enable authentication (default: true)
AUTH_ENABLED=true

# Redis live cache (optional but recommended for the live globe)
REDIS_URL=redis://localhost:6379

# OpenSky credentials unlock faster global refresh; anonymous mode is slower/degraded
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
LIVE_FLIGHTS_REFRESH_MS=120000
LIVE_FLIGHTS_CACHE_TTL_MS=300000
LIVE_FLIGHT_HISTORY_POINTS=18
LIVE_FLIGHT_LIMIT=7000
AUTO_REFRESH_EXTERNAL_LAYERS=true

# Environment: development, production (default: development)
NODE_ENV=development
