# Database connection
DATABASE_URL=postgres://postgres:password@localhost:5432/chrona
DATABASE_POOL_MAX=10

# API server port (default: 3000)
API_PORT=3000

# Web server port (default: 3001)
WEB_PORT=3001

# Web basemap configuration for the Cesium globe. Use `arcgis-world-imagery` for
# sharper aerial imagery, `osm-street` for street-cartography tiles, or
# `url-template` for a custom XYZ tile service.
MAP_IMAGERY_PROVIDER=arcgis-world-imagery
MAP_IMAGERY_URL=
MAP_IMAGERY_CREDIT=
MAP_IMAGERY_MAX_LEVEL=19

# Optional close-range 3D street scene support for the inspector's ground-view action.
# `google-photorealistic` uses Google photorealistic 3D tiles, `osm-buildings` loads
# Cesium's OSM buildings tileset, and `none` keeps the current system unchanged.
STREET_SCENE_PROVIDER=none
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=

# Logging level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Enable authentication (default: true)
AUTH_ENABLED=true
CORS_ALLOWED_ORIGIN=*

# Auth credentials (required in production, defaults shown are for dev only)
AUTH_PASSWORD_VIEWER=viewer123
AUTH_PASSWORD_OPERATOR=operator123
AUTH_PASSWORD_ADMIN=admin123

# Redis live cache (optional but recommended for the live globe)
REDIS_URL=redis://localhost:6379

# OpenSky credentials unlock faster global refresh; anonymous mode is slower/degraded
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
LIVE_FLIGHTS_REFRESH_MS=120000
LIVE_FLIGHTS_CACHE_TTL_MS=300000
LIVE_FLIGHT_HISTORY_POINTS=18
LIVE_FLIGHT_LIMIT=7000
AUTO_REFRESH_EXTERNAL_LAYERS=true

# SWAN protocol configuration
SWAN_ARTIFACT_ROOT=./runtime/swan
SWAN_MAX_THREADS_PER_SESSION=5
SWAN_MAX_GLOBAL_THREADS=20
SWAN_SESSION_IDLE_TTL_MS=1800000
SWAN_WATCH_INTERVAL_MS=60000
SWAN_PROVIDER_ALLOWLIST=app_context,existing_external_layers,external_research
SWAN_EXTERNAL_RESEARCH_FEEDS=

# Incident intelligence refresh (default: 300000ms = 5 min)
AUTO_REFRESH_INCIDENT_INTELLIGENCE=false
INCIDENT_INTELLIGENCE_REFRESH_MS=300000
INCIDENT_INTELLIGENCE_MAX_INCIDENTS_PER_SWEEP=10

# YouTube API for video intelligence (optional)
YOUTUBE_API_KEY=

# ===== Universal Data Sources =====
NEWSAPI_KEY=
MEDIASTACK_KEY=
OPENWEATHERMAP_KEY=
NASA_API_KEY=DEMO_KEY
ALPHAVANTAGE_KEY=
FRED_KEY=
ABUSEIPDB_KEY=
OTX_KEY=
SHODAN_KEY=
IPINFO_KEY=
UNIVERSAL_DATA_FETCH_INTERVAL_MS=60000
UNIVERSAL_DATA_CACHE_TTL_MS=60000
UNIVERSAL_DATA_STALE_TTL_MS=300000

# Environment: development, production (default: development)
NODE_ENV=development
