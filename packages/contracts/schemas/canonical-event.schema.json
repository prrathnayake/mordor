{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chrona/contracts/canonical-event/1.0.0",
  "title": "CanonicalEvent",
  "type": "object",
  "x-contract-name": "canonicalEvent",
  "x-schema-version": "1.0.0",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "object_id",
    "source_id",
    "observed_at",
    "ingested_at",
    "processed_at",
    "schema_version",
    "payload",
    "provenance",
    "confidence",
    "dedupe_key"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "position_observed",
        "state_observed",
        "camera_observed",
        "sensor_observed",
        "source_connected",
        "source_disconnected",
        "source_error",
        "normalization_failed",
        "zone_entered",
        "zone_exited",
        "route_deviation_detected",
        "alert_opened",
        "alert_closed"
      ]
    },
    "object_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "processed_at": { "type": "string", "format": "date-time" },
    "schema_version": { "const": "1.0.0" },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapter_version", "raw_ref"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "raw_ref": { "type": "string", "minLength": 1 },
        "transformation_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "trust_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dedupe_key": { "type": "string", "minLength": 1 },
    "geometry": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "type": "number" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "type": "number" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      ]
    },
    "altitude_m": { "type": ["number", "null"] },
    "heading_deg": { "type": ["number", "null"] },
    "speed_mps": { "type": ["number", "null"] },
    "related_object_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "parent_event_id": { "type": ["string", "null"], "minLength": 1 },
    "trace_id": { "type": ["string", "null"], "minLength": 1 }
  }
}
