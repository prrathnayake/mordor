{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swan Finding",
  "type": "object",
  "x-contract-name": "swanFinding",
  "x-schema-version": "1.0.0",
  "required": [
    "schema_version",
    "finding_id",
    "session_id",
    "thread_id",
    "provider",
    "target_type",
    "target_id",
    "finding_kind",
    "title",
    "summary",
    "details",
    "verification_status",
    "confidence",
    "projection_targets",
    "source_urls",
    "media",
    "generated_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "finding_kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "verification_status": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "projection_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lat": {
      "type": ["number", "null"]
    },
    "lon": {
      "type": ["number", "null"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
