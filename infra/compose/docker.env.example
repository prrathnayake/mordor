# MORDOR Docker Environment
# Copy this file to .env and modify as needed

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/chrona
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chrona

# API
PORT=3001
NODE_ENV=production

# Security
JWT_SECRET=change-this-in-production

# External Services (optional)
USGS_API_KEY=
CELESTRAK_API_KEY=
OPENWEATHER_API_KEY=
TRAFFIC_API_KEY=
